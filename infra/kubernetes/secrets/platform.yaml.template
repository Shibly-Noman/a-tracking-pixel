# NOTE: Never commit real secrets to git.
# In production, use external-secrets-operator or Vault to populate this.
# This file is a template; the actual Secret is created by CI/CD.
apiVersion: v1
kind: Secret
metadata:
  name: platform-secrets
  namespace: platform
type: Opaque
stringData:
  DATABASE_URL: "postgresql://platform:CHANGE_ME@postgres:5432/platform"
  JWT_SECRET: "CHANGE_ME_USE_STRONG_RANDOM_SECRET"
  INTERNAL_API_KEY: "CHANGE_ME_INTERNAL_SERVICE_KEY"
  CLICKHOUSE_PASSWORD: "CHANGE_ME"
